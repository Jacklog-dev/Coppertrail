/* Coppertrail theme (HANDOVER 8b). Filled at startup with str.format_map(tokens.DARK):
   a token name in single braces is a placeholder, literal braces are doubled. Fonts that QSS cannot express
   (Almendra uppercase with letter spacing, tabular figures) are set in code, see theme.py. */

/* No font-family/font-size on QWidget: a QSS font rule beats QWidget.setFont, which would
   flatten Almendra and the type scale. The app font (Caudex 14) comes from theme.font("body"). */
/* No background on plain QWidget either: Qt would paint every layout container as a bg1 box
   inside cards. The view background comes from the palette (Window = bg1) and #View. */
QWidget {{ color: {text1}; }}
QMainWindow, #View {{ background: {bg1}; }}
#NavRail, #FilterBar, #StatusStrip {{ background: {bg0}; }}
#NavRail {{ border-right: 1px solid {border}; }}
#FilterBar {{ border-bottom: 1px solid {border}; }}
#StatusStrip {{ border-top: 1px solid {border}; color: {text2}; font-size: 13px; }}

QFrame[role="card"] {{ background: {surface}; border: 1px solid {border}; border-radius: 4px; }}
QFrame[role="card"] QGraphicsView, QFrame[role="card"] QTabBar {{ background: transparent; }}
QFrame[role="card"] QFrame[role="swatch"] {{ border: 1px solid {border}; border-radius: 3px; }}
QLabel[role="cardTitle"] {{ color: {text1}; }}   /* font from theme.font("title") */
QLabel[role="h1"] {{ color: {text1}; }}          /* font from theme.font("h1") */
QLabel[role="sub"] {{ color: {text3}; font-size: 13px; }}
QLabel[role="label"] {{ color: {text3}; font-size: 13px; }}
QLabel[role="small"] {{ color: {text3}; font-size: 12px; }}
QLabel[role="legend"] {{ color: {text2}; font-size: 12px; }}
QLabel[role="secondary"] {{ color: {text2}; }}
QLabel[role="accent"] {{ color: {accent}; }}
QLabel[role="rise"] {{ color: {rise}; }}
QLabel[role="fall"] {{ color: {fall}; }}
QLabel[role="chip"] {{ background: {raised}; color: {text2}; border: 1px solid {border};
                      border-radius: 11px; padding: 2px 10px; font-size: 12px; }}
QFrame[role="rule"] {{ background: {grid}; border: 0; max-height: 1px; min-height: 1px; }}

QPushButton[role="nav"] {{ background: transparent; color: {text2}; border: 0; border-radius: 6px;
                          min-height: 40px; padding: 0 12px; text-align: left; }}
QPushButton[role="nav"]:hover {{ background: {raised}; color: {text1}; }}
QPushButton[role="nav"]:checked {{ background: {accentMuted}; color: {accent}; font-weight: 700; }}

QPushButton, QComboBox, QLineEdit, QSpinBox, QDateEdit {{
    background: {raised}; color: {text1}; border: 1px solid {border}; border-radius: 3px;
    min-height: 30px; padding: 0 10px; }}
QPushButton:hover, QComboBox:hover, QLineEdit:hover, QSpinBox:hover, QDateEdit:hover {{
    border-color: {borderStrong}; }}
QLineEdit:focus, QSpinBox:focus, QDateEdit:focus, QComboBox:focus {{ border-color: {borderStrong}; }}
QPushButton:disabled, QComboBox:disabled, QLineEdit:disabled, QSpinBox:disabled {{
    color: {textDis}; border-color: {border}; }}
QPushButton:checked {{ background: {accentMuted}; color: {accent}; border-color: {accent}; }}
QLineEdit {{ selection-background-color: {accentMuted}; selection-color: {text1}; }}
*[filterActive="true"] {{ border-color: {accent}; background: {accentMuted}; }}
QPushButton[role="primary"] {{ background: {accent}; color: {accentOn}; border: 0; font-weight: 700;
                              padding: 0 14px; }}
QPushButton[role="primary"]:hover {{ background: {accentHover}; }}
QPushButton[role="primary"]:pressed {{ background: {accentPressed}; }}
QPushButton[role="ghost"] {{ background: transparent; color: {text2}; min-height: 26px; font-size: 13px; }}
QPushButton[role="ghost"]:hover {{ color: {text1}; }}
QPushButton[role="link"] {{ background: transparent; color: {accent}; border: 0; padding: 0;
                           min-height: 0; }}
QPushButton[role="link"]:hover {{ color: {accentHover}; }}
QPushButton[role="segment"] {{ border-radius: 0; padding: 0 12px; color: {text2}; }}
QPushButton[role="segment"]:checked {{ background: {accentMuted}; color: {accent}; border-color: {accent}; }}

QComboBox::drop-down {{ border: 0; width: 20px; }}
QComboBox QAbstractItemView {{ background: {overlay}; border: 1px solid {borderStrong};
                              selection-background-color: {accentMuted}; selection-color: {accent};
                              outline: 0; }}
QSpinBox::up-button, QSpinBox::down-button {{ width: 0; border: 0; }}

QCheckBox {{ spacing: 8px; }}
QCheckBox::indicator {{ width: 14px; height: 14px; border: 1px solid {borderStrong};
                       border-radius: 3px; background: {raised}; }}
QCheckBox::indicator:checked {{ background: {accent}; border-color: {accent}; }}

QProgressBar {{ background: {raised}; border: 0; border-radius: 2px; max-height: 4px; min-height: 4px; }}
QProgressBar::chunk {{ background: {accent}; border-radius: 2px; }}
QProgressBar[role="rise"]::chunk {{ background: {rise}; }}

QTabBar {{ background: transparent; }}
QTabBar::tab {{ background: transparent; color: {text2}; padding: 10px 4px; margin-right: 24px;
               border: 0; border-bottom: 2px solid transparent; }}
QTabBar::tab:hover {{ color: {text1}; }}
QTabBar::tab:selected {{ color: {text1}; border-bottom-color: {accent}; font-weight: 700; }}

/* No selection colour: selected rows keep their per-item colours (rise/fall changes). */
QTableView, QTableWidget, QListWidget {{ background: {surface}; border: 0; gridline-color: {grid};
             alternate-background-color: {surface}; outline: 0;
             selection-background-color: {accentMuted}; }}
QTableView::item {{ border-bottom: 1px solid {grid}; padding: 0 10px; }}
QTableView::item:hover, QListWidget::item:hover {{ background: {raised}; }}
QTableView::item:selected, QListWidget::item:selected {{ background: {accentMuted}; }}
QHeaderView {{ background: {surface}; border: 0; }}
QHeaderView::section {{ background: {surface}; color: {text3}; border: 0;
                       border-bottom: 1px solid {border}; padding: 0 10px 8px; font-size: 13px; }}
QTableCornerButton::section {{ background: {surface}; border: 0; }}

QMenu, QListView[role="popover"], QDialog {{ background: {overlay}; border: 1px solid {borderStrong}; }}
QMenu::item {{ padding: 6px 16px; background: transparent; }}
QMenu::item:selected {{ background: {accentMuted}; color: {accent}; }}
QToolTip {{ background: {overlay}; color: {text1}; border: 1px solid {borderStrong}; padding: 8px 10px; }}

QScrollArea {{ border: 0; }}
QScrollBar:vertical {{ background: transparent; width: 8px; margin: 0; }}
QScrollBar::handle:vertical {{ background: {scroll}; border-radius: 3px; min-height: 30px; }}
QScrollBar:horizontal {{ background: transparent; height: 8px; margin: 0; }}
QScrollBar::handle:horizontal {{ background: {scroll}; border-radius: 3px; min-width: 30px; }}
QScrollBar::add-line, QScrollBar::sub-line {{ height: 0; width: 0; }}
QScrollBar::add-page, QScrollBar::sub-page {{ background: transparent; }}
